GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
MODEL=gemini-2.5-flash

# Vertex AI Search (Discovery Engine) recipe data store — separate from the
# Gemini location above; GENERIC search apps currently require "global".
# Product search no longer uses a data store — it calls the Kurly API
# directly (see kurly_client.py).
DISCOVERY_ENGINE_LOCATION=global
RECIPES_DATA_STORE_ID=
